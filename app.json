{
  "expo": {
    "name": "NEXO",
    "slug": "nexo-finanzas",
    "scheme": "nexo",
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "local.nexo.finanzas.demo",
      "icon": "./assets/branding/app-icon-ios.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": ["./plugins/with-nexo-launch", "expo-router", "expo-secure-store", ["expo-sqlite", { "useSQLCipher": true }]]
  }
}
